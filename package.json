{
  "name": "t42",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check . && turbo run lint",
    "lint:fix": "biome check --write . && turbo run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter='./packages/*'",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "clean": "node scripts/clean.mjs",
    "reset": "node scripts/clean.mjs && pnpm install",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 3 && pnpm db:migrate",
    "db:generate": "node scripts/run-with-app-env.mjs pnpm --filter @t42/db db:generate",
    "db:migrate": "node scripts/run-with-app-env.mjs pnpm --filter @t42/db db:migrate",
    "db:studio": "node scripts/run-with-app-env.mjs pnpm --filter @t42/db db:studio",
    "prepare": "node scripts/ensure-node-version.mjs && husky",
    "precommit": "lint-staged && pnpm typecheck"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.28.1"
    }
  }
}
