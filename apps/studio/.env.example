# ── Database ──────────────────────────────────────────────
# Auth tables live in the `auth` schema; Studio tables in `studio`; `public` is for user product tables.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/t42

# ── Auth (better-auth) ────────────────────────────────────
# You can generate the secret via 'openssl rand -base64 32' on Unix
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers (optional for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── Studio (Next.js) ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Observability (@t42/observability) ─────────────────────
LOG_APP_NAME=studio
LOG_LEVEL=debug
LOG_PRETTY=true
NEXT_PUBLIC_LOG_APP_NAME=studio

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
