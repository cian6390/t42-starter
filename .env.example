# Platform environment for db and auth scripts.
# Copy to .env at the repo root.
#
# App-specific variables belong in apps/<app>/.env.
# Set T42_ENV_APP=<app> so pnpm db:* loads that file instead.

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/t42

# ── Auth (better-auth) ────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers (optional for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── Observability (@t42/observability) ─────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
